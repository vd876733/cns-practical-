
#include <iostream>
#include <iomanip>
#include <string>
#include <openssl/sha.h>

using namespace std;

// Function to calculate SHA-1 digest
void calculateSHA1(string text) {
    unsigned char hash[SHA_DIGEST_LENGTH];

    SHA1(
        (unsigned char*)text.c_str(),
        text.length(),
        hash
    );

    cout << "Text: " << text << endl;
    cout << "SHA-1 Digest: ";

    for (int i = 0; i < SHA_DIGEST_LENGTH; i++) {
        cout << hex << uppercase
             << setw(2) << setfill('0')
             << (int)hash[i];
    }

    cout << dec << endl << endl;
}

int main() {
    string text1, text2;

    cout << "Enter first text: ";
    cin >> text1;

    cout << "Enter modified text: ";
    cin >> text2;

    cout << "\n--- SHA-1 RESULTS ---\n";

    calculateSHA1(text1);
    calculateSHA1(text2);

    cout << "SHA-1 produces a 160-bit digest "
         << "(40 hexadecimal characters).\n";

    cout << "Compare the digests to check whether "
         << "the inputs produce matching hashes.\n";

    return 0;
}
