import hashlib
import os

# Function to calculate SHA-1 hash of a file
def calculate_sha1(filename):
    sha1 = hashlib.sha1()

    with open(filename, "rb") as file:
        while True:
            data = file.read(4096)

            if not data:
                break

            sha1.update(data)

    return sha1.hexdigest()


# Create a sample file
filename = "sample.txt"

with open(filename, "w") as file:
    file.write("Hello World")

# Calculate original file digest
original_hash = calculate_sha1(filename)

print("Original SHA-1 Digest:", original_hash)

# Modify the file
with open(filename, "w") as file:
    file.write("Hello Python")

# Calculate modified file digest
modified_hash = calculate_sha1(filename)

print("\nModified SHA-1 Digest:", modified_hash)

# Compare both hashes
if original_hash == modified_hash:
    print("\nFile is unchanged.")
else:
    print("\nFile has been modified!")
