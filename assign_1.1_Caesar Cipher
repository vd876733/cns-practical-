
#include <iostream>
using namespace std;

int main() {
    string text;
    int key, choice;

    cout << "1. Encrypt\n2. Decrypt\n";
    cin >> choice;

    cout << "Enter text (no spaces): ";
    cin >> text;

    cout << "Enter key: ";
    cin >> key;

    key = key % 26;

    for (int i = 0; i < text.length(); i++) {
        char ch = text[i];

        if (ch >= 'A' && ch <= 'Z') {
            if (choice == 1)
                text[i] = (ch - 'A' + key) % 26 + 'A';
            else
                text[i] = (ch - 'A' - key + 26) % 26 + 'A';
        }
        else if (ch >= 'a' && ch <= 'z') {
            if (choice == 1)
                text[i] = (ch - 'a' + key) % 26 + 'a';
            else
                text[i] = (ch - 'a' - key + 26) % 26 + 'a';
        }
    }

    cout << "Result: " << text << endl;
    return 0;
}
