
#include <iostream>
#include <vector>
using namespace std;

int main() {
    string text;
    int rails, choice;

    cout << "1. Encrypt\n2. Decrypt\n";
    cin >> choice;

    cout << "Enter text (no spaces): ";
    cin >> text;

    cout << "Enter number of rails: ";
    cin >> rails;

    int n = text.length();

    if (rails < 2 || rails > n) {
        cout << "Invalid number of rails";
        return 0;
    }

    vector<vector<char>> mat(
        rails, vector<char>(n, '\0')
    );

    if (choice == 1) {
        int row = 0, dir = 1;

        for (int i = 0; i < n; i++) {
            mat[row][i] = text[i];

            if (row == 0) dir = 1;
            else if (row == rails - 1) dir = -1;

            row += dir;
        }

        string result = "";

        for (int i = 0; i < rails; i++)
            for (int j = 0; j < n; j++)
                if (mat[i][j] != '\0')
                    result += mat[i][j];

        cout << "Encrypted: " << result << endl;
    }
    else {
        int row = 0, dir = 1;

        for (int i = 0; i < n; i++) {
            mat[row][i] = '*';

            if (row == 0) dir = 1;
            else if (row == rails - 1) dir = -1;

            row += dir;
        }

        int k = 0;

        for (int i = 0; i < rails; i++)
            for (int j = 0; j < n; j++)
                if (mat[i][j] == '*')
                    mat[i][j] = text[k++];

        string result = "";
        row = 0;
        dir = 1;

        for (int i = 0; i < n; i++) {
            result += mat[row][i];

            if (row == 0) dir = 1;
            else if (row == rails - 1) dir = -1;

            row += dir;
        }

        cout << "Decrypted: " << result << endl;
    }

    return 0;
}
