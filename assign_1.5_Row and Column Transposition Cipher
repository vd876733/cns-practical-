
#include <iostream>
#include <vector>
using namespace std;

int main() {
    string text;
    int cols, choice;

    cout << "1. Encrypt\n2. Decrypt\n";
    cin >> choice;

    cout << "Enter text (no spaces): ";
    cin >> text;

    cout << "Enter number of columns: ";
    cin >> cols;

    if (cols <= 0) {
        cout << "Invalid number of columns";
        return 0;
    }

    int n = text.length();
    int rows = (n + cols - 1) / cols;

    if (choice == 1) {
        while (text.length() < rows * cols)
            text += 'X';

        vector<vector<char>> mat(
            rows, vector<char>(cols)
        );

        int k = 0;

        for (int i = 0; i < rows; i++)
            for (int j = 0; j < cols; j++)
                mat[i][j] = text[k++];

        string result = "";

        for (int j = 0; j < cols; j++)
            for (int i = 0; i < rows; i++)
                result += mat[i][j];

        cout << "Encrypted: " << result << endl;
    }
    else {
        if (n % cols != 0) {
            cout << "Invalid ciphertext length";
            return 0;
        }

        rows = n / cols;

        vector<vector<char>> mat(
            rows, vector<char>(cols)
        );

        int k = 0;

        for (int j = 0; j < cols; j++)
            for (int i = 0; i < rows; i++)
                mat[i][j] = text[k++];

        string result = "";

        for (int i = 0; i < rows; i++)
            for (int j = 0; j < cols; j++)
                result += mat[i][j];

        cout << "Decrypted: " << result << endl;
        cout << "Remove trailing padding X if present." << endl;
    }

    return 0;
}
